# ─── Application ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-32-random-chars
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000

# ─── Backend ──────────────────────────────────────────────────
# Browser-visible API base URL; for production use the public HTTPS URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]

# ─── Database ─────────────────────────────────────────────────
# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=wenxinlens123

# Milvus Vector DB
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=wenxinlens_architecture

# ─── LLM Providers ────────────────────────────────────────────
# OpenAI / GPT-4
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Qwen / DashScope (Alibaba)
DASHSCOPE_API_KEY=your-dashscope-key-here
QWEN_MODEL=qwen2.5-72b-instruct

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Embedding ────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# ─── Vision ───────────────────────────────────────────────────
YOLO_MODEL_PATH=models/yolov8_architecture.pt
CLIP_MODEL_NAME=openai/clip-vit-large-patch14
CLIP_CHECKPOINT_PATH=
VISION_CONFIDENCE_THRESHOLD=0.7
MAX_IMAGE_SIZE_MB=10

# ─── Voice / TTS ──────────────────────────────────────────────
TTS_PROVIDER=azure
AZURE_TTS_KEY=your-azure-tts-key
AZURE_TTS_REGION=eastasia
ELEVENLABS_API_KEY=your-elevenlabs-key

# ─── Auth / Security ──────────────────────────────────────────
# Development placeholders only. In production use distinct random secrets (32+ chars),
# set APP_DEBUG=false, set REDIS_PASSWORD and NEO4J_PASSWORD, and use exact HTTPS CORS origins.
JWT_SECRET_KEY=change-me-jwt-secret-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_KEY_HEADER=X-API-Key
MASTER_API_KEY=change-me-master-key

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500

# ─── RAG ──────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ─── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
